%% Indentation sets depth; each top-level branch takes the next palette color.
%% Shapes: `((circle))` root · `[square]` · `(rounded)` · `{{hexagon}}` · `)cloud(` · `))bang((` · bare text; depth, not color, carries meaning.
%% A label in "` `" is a markdown string (`**bold**`, `*italic*`), wrapped automatically.
%% `::icon(fa fa-…)` on the next line draws a `?` placeholder in 11.16 and nothing in Mermaid 12, and `:::name` needs page CSS that neither preview defines, so neither carries meaning here.
%% `config: { layout: tidy-tree }` needs a separately registered layout that neither preview ships, so the default layout is used.
mindmap
  root((Checkout))
    cart[Cart · square]
      Saved carts
      Promo codes
    pay(Payment · rounded)
      Cards
      Wallets
      fraud["`**Fraud check** before *capture*`"]
    ship{{Shipping · hexagon}}
      Rates
      Tracking
    risks)Open questions · cloud(
      Tax per region
    launch))Launch · bang((
