---
title: dinyd · build · release and run boundary
config:
  look: handDrawn
  handDrawnSeed: 5
  theme: dark
  themeVariables:
    mainBkg: "#333333"
    clusterBkg: "#242424"
  themeCSS: |
    small { display: inline-block; text-align: left; }
  flowchart:
    wrappingWidth: 300
---
%% Behavior authority: distribution.md.
flowchart LR
  Tag["version tag push"]
  subgraph Build["GitHub Actions · dist"]
    Matrix["native platform builds"]
    Release@{ shape: docs, label: "release artifacts<br/><small>archives · checksums · installers</small>" }
    Matrix --> Release
  end
  Bootstrap["bootstrap installer<br/><small>user bin · PATH</small>"]
  Fetch["native acquisition<br/><small>verify the archive's SHA-256</small>"]
  Global@{ shape: fr-rect, label: "dinyd on PATH" }
  Cache@{ shape: bow-rect, label: "exact-version runtimes" }

  Tag --> Matrix
  Release --> Bootstrap --> Global
  Release --> Fetch
  Fetch -->|project runtime| Cache
  Fetch -->|self-update| Global

  classDef em fill:#173d25,stroke:#86efac
  classDef cache fill:#163a40,stroke:#67e8f9
  classDef file fill:#3d3415,stroke:#fcd34d
  class Fetch em
  class Cache cache
  class Release file
