title: dinyd · build · release and run boundary
config:
  look: handDrawn
  handDrawnSeed: 5
  theme: dark
  themeVariables:
    mainBkg: "#333333"
    clusterBkg: "#242424"
  themeCSS: |
    small { display: inline-block; text-align: left; }
  flowchart:
    wrappingWidth: 300
---
%% Behavior authority: distribution.md.
flowchart LR
  Tag["version tag push"]
  subgraph Build["GitHub Actions · dist"]
    Matrix["per-platform builds<br/><small>• linux x64 · arm64 (musl)<br/>• macOS arm64 · x64<br/>• Windows x64</small>"]
    Release@{ shape: docs, label: "GitHub Releases<br/><small>archive · checksum</small>" }
    Matrix --> Release
  end
  subgraph Consumer["consuming project"]
    Invoke["run dinyd<br/><small>• gate · check while working<br/>• verdict by exit code</small>"]
    GitBin@{ shape: fr-rect, label: "git<br/><small>needed at run time</small>" }
    Invoke --> GitBin
  end
  Tag --> Matrix
  Release --> Invoke

  classDef em fill:#173d25,stroke:#86efac
  classDef file fill:#3d3415,stroke:#fcd34d
  class Invoke em
  class Release file
